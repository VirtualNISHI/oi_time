# Discord Webhook URL
# Discordチャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック → URLをコピー
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/yyyyyyyyyy

# X (Twitter) API v2 credentials  (Read and Write 権限が必要)
# https://developer.x.com/ で取得
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# X 投稿の有効化スイッチ (false = 認証情報があっても投稿しない)
# 安全のためデフォルトoff。GitHub Actions では workflow_dispatch の
# "enable_x" 入力でその run だけ true にできる。
ENABLE_X=false

# Gemini API (現状はオプション。将来の日本語/英語翻訳用)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 投稿対象のフォルダ (省略時は ./images)
IMAGES_DIR=./images

# 同じファイルを二重投稿しないためのステート保存先
STATE_FILE=.last_posted.json

# Chart generation
CHART_LOOKBACK_HOURS=24      # データ収集期間 (時間)
CHART_RANGE_PCT=3            # 表示価格レンジ ±%

# 投稿テキストのテンプレート
# 使えるプレースホルダ:
#   {timestamp}  例: 2026-05-17 18:05
#   {mark}       例: $103,250
#   {lookback_h} 例: 24
#   {vol_buy}    例: 1,234   (Trade買い約定 合計BTC)
#   {vol_sell}   例: 1,189
#   {liq_short}  例: 23      (ショート精算 合計BTC)
#   {liq_long}   例: 17
# 注意: 改行 \n を使いたい場合は値を **ダブルクォート** で囲む (python-dotenvの仕様)
POST_TEMPLATE="【BTC OI/Liq 24h】Mark {mark} | OI {oi} BTC ({oi_chg})\nVol B/S {vol_buy}/{vol_sell} | Liq S/L {liq_short}/{liq_long} BTC\n{commentary}\n{timestamp} JST #BTC #Bitcoin"
