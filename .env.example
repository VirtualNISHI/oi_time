# Discord Webhook URL
# Discordチャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック → URLをコピー
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/yyyyyyyyyy

# X (Twitter) API v2 credentials  (Read and Write 権限が必要)
# https://developer.x.com/ で取得
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# X 投稿の有効化スイッチ (false = 認証情報があっても投稿しない)
# 安全のためデフォルトoff。GitHub Actions では workflow_dispatch の
# "enable_x" 入力でその run だけ true にできる。
ENABLE_X=false

# --- 日本語コメンテート (Commentary) ---
# 投稿に1行の日本語コメントを添える。複数プロバイダのフォールバックチェーンで動作:
#   default: gemini → grok → openai → deepl
# COMMENTARY_PROVIDERS でカンマ区切り上書き可 (例: "openai,gemini")。
# キー未設定のプロバイダは自動でスキップされる。
COMMENTARY_PROVIDERS=

# Gemini API  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Grok (xAI) API  https://console.x.ai/
XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# OpenAI API  https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=  # Azure / プロキシ用 (通常は空)

# DeepL API  https://www.deepl.com/pro-api
# DeepL は翻訳専用なので、英語サマリを生成して日本語に翻訳する fallback として使用。
# Free プランのキーは末尾が ":fx" → 自動で api-free エンドポイントへルーティング。
DEEPL_API_KEY=

# Coinalyze API (https://coinalyze.net/) — 多取引所アグリゲータ。
# Binance/Bybit を直接叩くと GitHub Actions の US IP が 451/403 で
# ブロックされるため、本プロジェクトは Coinalyze 経由で取得する。
# 無料枠: 40 req/min (6時間に1回の運用なら余裕)
COINALYZE_API_KEY=

# 投稿対象のフォルダ (省略時は ./images)
IMAGES_DIR=./images

# 同じファイルを二重投稿しないためのステート保存先
STATE_FILE=.last_posted.json

# Chart generation
CHART_LOOKBACK_HOURS=24      # データ収集期間 (時間)
CHART_RANGE_PCT=3            # 表示価格レンジ ±%

# 投稿テキストのテンプレート
# 使えるプレースホルダ:
#   {timestamp}  例: 2026-05-19 22:03
#   {mark}       例: $103,250
#   {lookback_h} 例: 24
#   {vol_buy}    例: 147,694  (Trade買い約定 合計BTC)
#   {vol_sell}   例: 152,094
#   {liq_short}  例: 166      (ショート精算 合計BTC)
#   {liq_long}   例: 358
#   {oi}         例: 191,515
#   {oi_chg}     例: -1.06%
#   {commentary} Gemini→Grok→OpenAI→DeepL 経由の1行解説 (空のときは行ごと自動で畳まれる)
# 注意:
#   - 改行 \n を使う場合は値を **ダブルクォート** で囲む (python-dotenvの仕様)
#   - 連続する空行は post_chart 側で 1つにまとめる ({commentary} 空時の崩れ防止)
POST_TEMPLATE="【BTC価格帯別OIマップ】 Mark {mark}\n\nVol  買 {vol_buy} / 売 {vol_sell} BTC\nLiq  S {liq_short} / L {liq_long} BTC\nOI   {oi} BTC ({oi_chg})\n\n{commentary}\n\n{timestamp} JST  #BTC #Bitcoin\n※OIはAIが収集したもので推定となります"

# --- Japanese translation chain (shared jp_translator module) ---
# 順序: Gemini → OpenAI → Grok → DeepL (fallback chain)。
# 最低 1 つ設定すれば動く (失敗時のみ次へ)。
#  1) Gemini  : https://aistudio.google.com/apikey  (free 1500 RPD)
#  2) OpenAI  : https://platform.openai.com/api-keys (paid)。GPT-4o/GPT-5 系
#  3) Grok    : https://console.x.ai                (paid)。GROK_API_KEY も別名で可
#  4) DeepL   : https://www.deepl.com/pro-api       (free 500K char/月。:fx で終わる)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPL_API_KEY=
# 任意: モデル上書き (default は thinking 非搭載の lite モデル)
#JP_TRANSLATOR_GEMINI_MODEL=gemini-2.5-flash-lite
#JP_TRANSLATOR_OPENAI_MODEL=gpt-4o-mini
#JP_TRANSLATOR_GROK_MODEL=grok-2-1212
